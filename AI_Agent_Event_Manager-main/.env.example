# Copy this file to .env and fill in the MS SQL credentials from Somee:
# Control Panel → MS SQL → your database → Connection details

SITE_URL=http://AiEvents.somee.com

# SQL Server address from Somee (not the website URL)
DATABASE_HOST=AiEventsDB.mssql.somee.com
DATABASE_NAME=AiEventsDB
DATABASE_USER=Avishag10_SQLLogin_1
DATABASE_PASSWORD=your_somee_db_password
DATABASE_PORT=1433
DATABASE_DRIVER=pyodbc
DATABASE_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Optional: paste the full Somee "Connection string" instead of the fields above.
# DATABASE_URL=workstation id=AiEventsDB.mssql.somee.com;packet size=4096;user id=Avishag10_SQLLogin_1;pwd=YOUR_PASSWORD;data source=AiEventsDB.mssql.somee.com;persist security info=False;initial catalog=AiEventsDB
