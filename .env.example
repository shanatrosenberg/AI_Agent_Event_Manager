DATABASE_URL=http://my-event-manager.somee.com
DATABASE_NAME=my-event-manager
DATABASE_USER=your_somee_db_user
DATABASE_PASSWORD=your_somee_db_password

# Single Event Organizer admin account (password is hashed with Werkzeug before storage)
ORGANIZER_ADMIN_ID=org-admin
ORGANIZER_ADMIN_NAME=Event Organizer
ORGANIZER_ADMIN_USERNAME=admin@smartevents.local
ORGANIZER_ADMIN_PASSWORD=AdminPass!2026
SECRET_KEY=change-this-secret-key

# Hugging Face Inference API (speaker "Enhance with AI")
HUGGINGFACE_API_KEY=hf_your_token_here
HF_TOKEN=hf_your_token_here
HUGGINGFACE_MODEL=google/flan-t5-large

# Vector embeddings / semantic search (RAG)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Background Deep Agent + MCP tools (Tavily web search)
TAVILY_API_KEY=tvly_your_key_here
ASSESSMENT_AGENT_AUTOSTART=1
ASSESSMENT_AGENT_INTERVAL=45
